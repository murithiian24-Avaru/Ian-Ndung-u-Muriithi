<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and higher: exclude all AdLease app data from cloud
     backup and device-to-device transfer. The exclusions apply to every
     storage domain, and no <include> rules are given, so nothing is copied.
     Android 11 and lower are covered by android:allowBackup="false" in
     AndroidManifest.xml. Transfer to an iPhone is opt-in on Android, so no
     cross-platform-transfer section is given: adding one would opt in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
