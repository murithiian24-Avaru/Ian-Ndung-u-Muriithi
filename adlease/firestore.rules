rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, delete: if false;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phoneNumber', 'country', 'locale', 'updatedAt']);
    }

    match /verificationCases/{caseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /verificationDecisions/{id} { allow read, write: if false; }
    match /adSessions/{id} { allow read, write: if false; }
    match /rewardClaims/{id} { allow read, write: if false; }
    match /rewardLedger/{id} { allow read, write: if false; }
    match /wallets/{uid} { allow read: if owns(uid); allow write: if false; }
    match /dailyRewardCounters/{id} { allow read, write: if false; }
    match /adminAudit/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
